#include "ooo_cpu.h"

#define TWO_BIT_TABLE_SIZE 16384

int two_bit_table[NUM_CPUS][TWO_BIT_TABLE_SIZE];

void O3_CPU::initialize_branch_predictor()
{
    cout << "CPU " << cpu << " 2-bit branch predictor" << endl;

    // Initialize all counters to Weakly Not Taken (01)
    for (int i = 0; i < TWO_BIT_TABLE_SIZE; i++)
        two_bit_table[cpu][i] = 1;
}

uint8_t O3_CPU::predict_branch(uint64_t ip)
{
    // Use branch PC to index the predictor table
    uint32_t index = ip % TWO_BIT_TABLE_SIZE;

    // 00, 01 -> Not Taken
    // 10, 11 -> Taken
    uint8_t prediction =
        (two_bit_table[cpu][index] >= 2) ? 1 : 0;

    return prediction;
}

void O3_CPU::last_branch_result(uint64_t ip, uint8_t taken)
{
    uint32_t index = ip % TWO_BIT_TABLE_SIZE;

    if (taken)
    {
        // Taken: increment toward Strongly Taken
        if (two_bit_table[cpu][index] < 3)
            two_bit_table[cpu][index]++;
    }
    else
    {
        // Not Taken: decrement toward Strongly Not Taken
        if (two_bit_table[cpu][index] > 0)
            two_bit_table[cpu][index]--;
    }
}